# Copy to frontend/.env.local and fill with Firebase Web App config.
# These values identify your Firebase project; they are not Admin credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: set to "true" only when using the local Firebase Emulator Suite.
VITE_USE_FIREBASE_EMULATORS=false
